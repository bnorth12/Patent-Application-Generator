#!/usr/bin/env sh

set -e

echo "[pre-push] Running pre-push governance gate..."

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/pre-push-gate.ps1
else
  powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pre-push-gate.ps1
fi

echo "[pre-push] Passed."
exit 0
